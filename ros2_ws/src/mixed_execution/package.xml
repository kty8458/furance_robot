<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xxsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mixed_execution</name>
  <version>0.1.0</version>
  <description>Mixed function execution service: vision+chassis hybrid scripts exposed to workflow</description>
  <maintainer email="banwf@foxmail.com">baosight</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>furance_interfaces</exec_depend>
  <exec_depend>control_interfaces</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
